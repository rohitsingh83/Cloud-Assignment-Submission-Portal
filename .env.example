# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Security & Authentication (Change in production!)
SECRET_KEY=cloud-assignment-portal-super-secret-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# - SQLite (Zero-config local development): sqlite:///./assignment_portal.db
# - Supabase PostgreSQL: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./assignment_portal.db
SUPABASE_DB_URL=

# Supabase Cloud Integration (Cloud Object Storage & PostgreSQL)
# Get these from your Supabase Project Settings -> API & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=assignments

# Storage Driver: "local" (Simulates Cloud Object Storage), "supabase" (Native Supabase Cloud Bucket), or "s3"
STORAGE_DRIVER=local
STORAGE_BUCKET_NAME=cloud-assignment-portal-submissions
LOCAL_STORAGE_DIR=./cloud_storage_bucket

# Upload Constraints
MAX_FILE_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,zip,png,jpg,jpeg
